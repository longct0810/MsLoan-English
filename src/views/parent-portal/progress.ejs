<%- include('../partials/app-start', { title }) %>
<% if (!portal.snapshot) { %><div class="alert alert-info">Tài khoản chưa được liên kết với học sinh.</div><% } else { const p = portal.snapshot; %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
  <div><h1 class="h3 mb-1">Kết quả học tập của <%= portal.selected.fullName %></h1><p class="text-secondary mb-0">Chi tiết năng lực, điểm và chuyên cần.</p></div>
  <% if (portal.children.length > 1) { %>
    <form method="get" action="/parent/progress"><select name="childId" class="form-select" onchange="this.form.submit()"><% portal.children.forEach(c => { %><option value="<%= c.id %>" <%= c.id === portal.selected.id ? 'selected' : '' %>><%= c.fullName %></option><% }) %></select></form>
  <% } %>
</div>
<div class="row g-4">
  <div class="col-xl-5">
    <div class="card app-card">
      <div class="card-header"><strong>Năng lực theo kỹ năng</strong></div>
      <div class="card-body">
        <% p.skills.forEach(skill => { %><div class="skill-row mb-4"><div class="d-flex justify-content-between mb-2"><span class="fw-semibold"><%= skill.skill %></span><strong><%= skill.score %>/10</strong></div><div class="progress skill-progress lg"><div class="progress-bar" style="width:<%= skill.score * 10 %>%"></div></div></div><% }) %>
      </div>
    </div>
  </div>
  <div class="col-xl-7">
    <div class="card app-card mb-4">
      <div class="card-header"><strong>Lịch sử điểm</strong></div>
      <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Ngày</th><th>Nội dung</th><th>Kỹ năng</th><th>Điểm</th></tr></thead><tbody><% p.scores.forEach(s => { %><tr><td><%= new Date(s.recordedAt).toLocaleDateString('vi-VN') %></td><td class="fw-semibold"><%= s.title %></td><td><%= s.category %></td><td><span class="score-badge <%= s.score >= 8 ? 'good' : (s.score < 7 ? 'warn' : '') %>"><%= s.score %></span></td></tr><% }) %></tbody></table></div>
    </div>
    <div class="card app-card">
      <div class="card-header"><strong>Chuyên cần</strong></div>
      <div class="card-body"><div class="d-flex align-items-end gap-2 mb-4"><div class="display-6 fw-bold"><%= p.student.attendanceRate %>%</div><div class="text-secondary pb-2">tỷ lệ tham gia</div></div><% p.attendance.forEach(a => { %><div class="d-flex justify-content-between gap-3 py-2 border-bottom"><span><%= new Date(a.date).toLocaleDateString('vi-VN') %><% if (a.topic) { %><div class="small text-secondary"><%= a.topic %></div><% } %></span><span class="badge <%= a.statusMeta.className %>"><%= a.statusMeta.label %></span></div><% }) %></div>
    </div>
  </div>
</div>
<% } %>
<%- include('../partials/app-end') %>
