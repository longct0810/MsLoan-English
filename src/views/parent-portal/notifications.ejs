<%- include('../partials/app-start', { title }) %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
  <div><div class="eyebrow">Theo dõi chủ động</div><h1 class="h3 mb-1">Thông báo học tập</h1><p class="text-secondary mb-0">Các cập nhật mới nhất về việc học của <%= portal.selected?.fullName || 'học sinh' %>. <span class="badge text-bg-primary"><%= portal.unreadCount || 0 %> chưa đọc</span></p></div>
  <% if (portal.children.length > 1) { %><form method="get" action="/parent/notifications" class="child-switcher"><label class="small text-secondary mb-1">Chọn học sinh</label><select name="childId" class="form-select" onchange="this.form.submit()"><% portal.children.forEach(c => { %><option value="<%= c.id %>" <%= c.id === portal.selected.id ? 'selected' : '' %>><%= c.fullName %></option><% }) %></select></form><% } %>
</div>
<div class="notification-list app-card">
  <% if (!portal.notifications.length) { %><div class="p-5 text-center text-secondary"><div class="empty-state-icon mb-2">✓</div><div class="fw-semibold">Chưa có thông báo mới</div><div class="small">Các cập nhật học tập sẽ xuất hiện tại đây.</div></div><% } %>
  <% portal.notifications.forEach(notification => { %><div class="notification-item notification-<%= notification.type %> <%= notification.isRead ? 'is-read' : '' %>"><span class="notification-dot" aria-hidden="true"></span><span class="flex-grow-1"><a class="notification-link" href="<%= notification.href %>"><strong><%= notification.title %></strong><span class="d-block text-secondary mt-1"><%= notification.body %></span><small class="text-secondary"><%= notification.date ? new Date(notification.date).toLocaleDateString('vi-VN') : '' %></small></a></span><% if (!notification.isRead) { %><form method="post" action="/parent/notifications/read"><input type="hidden" name="notificationKey" value="<%= notification.key %>"><input type="hidden" name="childId" value="<%= portal.selected.id %>"><button class="btn btn-sm btn-light text-nowrap">Đã đọc</button></form><% } %></div><% }) %>
</div>
<%- include('../partials/app-end') %>
