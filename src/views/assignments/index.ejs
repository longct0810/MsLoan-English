<%- include('../partials/app-start', { title }) %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">Bài tập & chấm bài</h1>
    <p class="text-secondary mb-0">Giao bài theo lớp, theo dõi tiến độ nộp và chấm trực tiếp.</p>
  </div>
  <a class="btn btn-primary" href="/assignments/new">+ Giao bài tập</a>
</div>

<div class="card app-card mb-4">
  <div class="card-body">
    <form class="row g-3 align-items-end" method="get" action="/assignments">
      <div class="col-md-5">
        <label class="form-label">Lớp học</label>
        <select class="form-select" name="classId">
          <option value="">Tất cả lớp</option>
          <% classes.forEach(item => { %><option value="<%= item.id %>" <%= String(filters.classId || '') === String(item.id) ? 'selected' : '' %>><%= item.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Trạng thái</label>
        <select class="form-select" name="status">
          <option value="">Tất cả</option>
          <option value="DRAFT" <%= filters.status === 'DRAFT' ? 'selected' : '' %>>Bản nháp</option>
          <option value="PUBLISHED" <%= filters.status === 'PUBLISHED' ? 'selected' : '' %>>Đã giao</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-primary flex-grow-1">Lọc</button><a href="/assignments" class="btn btn-outline-secondary">Xóa lọc</a></div>
    </form>
  </div>
</div>

<div class="card app-card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>Bài tập</th><th>Lớp</th><th>Hạn nộp</th><th>Trạng thái</th><th>Tiến độ</th><th>Đã chấm</th><th></th></tr></thead>
        <tbody>
          <% if (!assignments.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">Chưa có bài tập phù hợp.</td></tr><% } %>
          <% assignments.forEach(a => { %>
            <tr>
              <td><strong><%= a.title %></strong><div class="small text-secondary"><%= a.type %><% if (a.lessonTitle) { %> • <%= a.lessonTitle %><% } %></div></td>
              <td><%= a.className %></td>
              <td><%= a.dueAt ? new Date(a.dueAt).toLocaleString('vi-VN') : '—' %></td>
              <td><span class="badge <%= a.status === 'PUBLISHED' ? 'text-bg-success' : 'text-bg-warning' %>"><%= a.status === 'PUBLISHED' ? 'Đã giao' : 'Bản nháp' %></span></td>
              <td><strong><%= a.submitted %>/<%= a.total %></strong><div class="progress mt-2 assignment-progress"><div class="progress-bar" style="width:<%= a.total ? Math.round(a.submitted * 100 / a.total) : 0 %>%"></div></div></td>
              <td><strong><%= a.graded %>/<%= a.total %></strong></td>
              <td class="text-end"><a href="/assignments/<%= a.id %>" class="btn btn-sm btn-outline-primary">Mở</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/app-end') %>
