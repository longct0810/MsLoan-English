<%- include('../partials/app-start', { title }) %>
<div class="card app-card mb-4"><div class="card-body p-4"><div class="d-flex flex-column flex-lg-row justify-content-between gap-3"><div><div class="small text-secondary"><%= exam.className %> • Khối <%= exam.grade %></div><h1 class="h3 mt-1"><%= exam.title %></h1><p class="text-secondary mb-0"><%= exam.description||'Không có mô tả.' %></p></div><div class="d-flex gap-2 align-items-start"><a href="/exams" class="btn btn-outline-secondary">Danh sách</a><% if(exam.status==='DRAFT'){ %><a href="/exams/<%= exam.id %>/edit" class="btn btn-outline-primary">Sửa đề</a><form method="post" action="/exams/<%= exam.id %>/publish"><button class="btn btn-success">Xuất bản đề</button></form><% } else if(exam.status==='PUBLISHED'){ %><form method="post" action="/exams/<%= exam.id %>/close" onsubmit="return confirm('Đóng bài kiểm tra sớm?')"><button class="btn btn-outline-danger">Đóng đề</button></form><% } %></div></div><div class="d-flex flex-wrap gap-2 mt-3"><span class="class-chip"><%= exam.questions.length %> câu</span><span class="class-chip"><%= exam.totalPoints %> điểm</span><span class="class-chip"><%= exam.durationMinutes %> phút</span><span class="class-chip"><%= exam.maxAttempts %> lần làm</span><% if(exam.hasEssay){ %><span class="class-chip">Có câu tự luận</span><% } %><span class="badge <%= exam.status==='PUBLISHED'?'text-bg-success':'text-bg-warning' %>"><%= exam.status %></span></div></div></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Đã nộp</div><div class="metric-value"><%= exam.analytics?.submitted || 0 %></div><div class="metric-meta">Lượt hoàn thành</div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Chờ chấm</div><div class="metric-value text-warning"><%= exam.analytics?.pendingGrading || 0 %></div><div class="metric-meta">Có câu tự luận</div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Điểm trung bình</div><div class="metric-value"><%= exam.analytics?.averageScore==null?'—':Number(exam.analytics.averageScore).toFixed(1) %></div><div class="metric-meta">Chỉ tính bài đã chấm xong</div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Điểm cao nhất</div><div class="metric-value"><%= exam.analytics?.highestScore==null?'—':Number(exam.analytics.highestScore).toFixed(1) %></div><div class="metric-meta">Trên <%= exam.totalPoints %> điểm</div></div></div></div>
<div class="row g-4"><div class="col-xl-7"><div class="card app-card"><div class="card-header"><strong>Nội dung đề & phân tích câu hỏi</strong></div><div class="card-body"><% exam.questions.forEach((q,i)=>{ %><div class="exam-question-preview <%= i?'border-top pt-4 mt-4':'' %>"><div class="d-flex justify-content-between gap-3"><div class="fw-semibold">Câu <%= i+1 %>. <%= q.stem %></div><span class="badge text-bg-light border"><%= q.points %>đ</span></div>
<% if(q.questionType==='FILL_BLANK'){ %><div class="small text-success mt-2">Đáp án: <strong><%= q.correctAnswer %></strong></div>
<% } else if(q.questionType==='ESSAY'){ %><div class="small text-primary mt-2">Tự luận • Giáo viên chấm thủ công</div><% if(q.correctAnswer){ %><div class="small text-secondary mt-1">Gợi ý: <%= q.correctAnswer %></div><% } %>
<% } else { %><div class="mt-2"><% q.options.forEach(o=>{ %><div class="small <%= o.isCorrect?'text-success fw-semibold':'text-secondary' %>"><%= o.optionKey %>. <%= o.optionText %> <%= o.isCorrect?'✓':'' %></div><% }) %></div><% } %>
<% if(q.questionType!=='ESSAY'){ %><div class="mt-3"><div class="d-flex justify-content-between small text-secondary mb-1"><span>Tỷ lệ trả lời đúng</span><strong><%= q.accuracy==null?'Chưa có dữ liệu':q.accuracy+'%' %></strong></div><div class="progress skill-progress"><div class="progress-bar" style="width:<%= q.accuracy||0 %>%"></div></div><div class="small text-secondary mt-1"><%= q.correctCount||0 %>/<%= q.answeredCount||0 %> lượt đúng</div></div><% } else { %><div class="mt-3 small text-secondary">Câu tự luận không tính tỷ lệ đúng/sai tự động.</div><% } %></div><% }) %></div></div></div>
<div class="col-xl-5"><div class="card app-card"><div class="card-header"><strong>Kết quả học sinh</strong></div><div class="card-body p-0"><% if(!exam.attempts.length){ %><div class="text-center text-secondary py-5">Chưa có lượt làm bài.</div><% } %><% exam.attempts.forEach(a=>{ const pending=a.status==='PENDING_GRADING'; %><div class="p-3 border-bottom"><div class="d-flex justify-content-between gap-2"><div><strong><%= a.studentName %></strong><div class="small text-secondary">Lần <%= a.attemptNo %> • <%= pending?'Chờ chấm tự luận':a.status %></div></div><div class="text-end"><strong><%= pending?`Tạm tính ${a.autoScore||0}/${a.maxScore}`:(a.score==null?'—':`${a.score}/${a.maxScore}`) %></strong><div class="small text-secondary"><%= a.submittedAt?new Date(a.submittedAt).toLocaleString('vi-VN'):'Đang làm' %></div></div></div><% if((pending||a.status==='GRADED')&&exam.hasEssay){ %><div class="mt-2"><a class="btn btn-sm <%= pending?'btn-warning':'btn-outline-primary' %>" href="/exams/<%= exam.id %>/attempts/<%= a.id %>/grade"><%= pending?'Chấm tự luận':'Xem / chấm lại' %></a></div><% } %></div><% }) %></div></div></div></div>
<%- include('../partials/app-end') %>
