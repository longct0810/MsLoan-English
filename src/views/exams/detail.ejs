<%- include('../partials/app-start', { title }) %>
<% if(notice){ %><div class="alert alert-success"><%= notice %></div><% } %><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="card app-card mb-4"><div class="card-body p-4">
  <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
    <div><div class="small text-secondary"><%= exam.className %> • Khối <%= exam.grade %></div><h1 class="h3 mt-1"><%= exam.title %></h1><p class="text-secondary mb-0"><%= exam.description||'Không có mô tả.' %></p></div>
    <div class="d-flex flex-wrap gap-2 align-items-start"><a href="/exams" class="btn btn-outline-secondary">Danh sách</a><form method="post" action="/exams/<%= exam.id %>/duplicate"><button class="btn btn-outline-primary">Nhân bản đề</button></form><% if(exam.status==='DRAFT'){ %><a href="/exams/<%= exam.id %>/edit" class="btn btn-outline-primary">Sửa đề</a><form method="post" action="/exams/<%= exam.id %>/publish" onsubmit="return confirm('Xuất bản sẽ tạo snapshot bất biến của đề. Tiếp tục?')"><button class="btn btn-success">Xuất bản đề</button></form><% } else if(exam.status==='PUBLISHED'){ %><form method="post" action="/exams/<%= exam.id %>/close" onsubmit="return confirm('Đóng bài kiểm tra sớm?')"><button class="btn btn-outline-danger">Đóng đề</button></form><% } %></div>
  </div>
  <div class="d-flex flex-wrap gap-2 mt-3"><span class="class-chip"><%= exam.questions.length %> câu</span><span class="class-chip"><%= exam.totalPoints %> điểm</span><span class="class-chip"><%= exam.durationMinutes %> phút</span><span class="class-chip"><%= exam.maxAttempts %> lần làm</span><span class="class-chip">Đạt ≥ <%= exam.passScorePercent ?? 50 %>%</span><span class="class-chip"><%= exam.selectionMode==='POOL'?'Question Pool':'Chọn thủ công' %></span><% if(exam.randomizeQuestions){ %><span class="class-chip">Xáo câu</span><% } %><% if(exam.randomizeOptions){ %><span class="class-chip">Xáo đáp án</span><% } %><span class="badge <%= exam.status==='PUBLISHED'?'text-bg-success':exam.status==='CLOSED'?'text-bg-secondary':'text-bg-warning' %>"><%= exam.status %></span></div>
  <% if(exam.status!=='DRAFT'){ %><div class="alert alert-light border small mt-3 mb-0"><strong>Snapshot đã khóa:</strong> nội dung đề đang dùng bản chụp tại thời điểm xuất bản, nên việc sửa Question Bank về sau không thay đổi đề này.</div><% } %>
</div></div>

<% if(exam.selectionMode==='POOL' && exam.poolRules?.length){ %><div class="card app-card mb-4"><div class="card-header"><strong>Question Pool</strong></div><div class="card-body"><div class="row g-2"><% exam.poolRules.forEach(r=>{ %><div class="col-md-6"><div class="border rounded p-3"><strong><%= r.questionCount %> câu</strong> • <%= r.skillCode||'Mọi kỹ năng' %> • <%= r.difficulty||'Mọi độ khó' %> • <%= r.questionType||'Mọi loại' %></div></div><% }) %></div></div></div><% } %>

<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Đã nộp</div><div class="metric-value"><%= exam.analytics?.submitted || 0 %></div><div class="metric-meta">Lượt hoàn thành</div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Chờ chấm</div><div class="metric-value text-warning"><%= exam.analytics?.pendingGrading || 0 %></div><div class="metric-meta">Có câu tự luận</div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Điểm trung bình</div><div class="metric-value"><%= exam.analytics?.averageScore==null?'—':Number(exam.analytics.averageScore).toFixed(1) %></div><div class="metric-meta">Bài đã chấm</div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Điểm cao nhất</div><div class="metric-value"><%= exam.analytics?.highestScore==null?'—':Number(exam.analytics.highestScore).toFixed(1) %></div><div class="metric-meta">Trên <%= exam.totalPoints %> điểm</div></div></div></div>

<div class="row g-4">
  <div class="col-xl-7"><div class="card app-card"><div class="card-header"><strong>Nội dung đề & phân tích câu hỏi</strong></div><div class="card-body"><% exam.questions.forEach((q,i)=>{ %><div class="exam-question-preview <%= i?'border-top pt-4 mt-4':'' %>"><div class="d-flex justify-content-between gap-3"><div><div class="fw-semibold">Câu <%= i+1 %>. <%= q.stem %></div><% if(q.skillCodes?.length){ %><div class="small text-primary mt-1"><%= q.skillCodes.join(' • ') %></div><% } %></div><span class="badge text-bg-light border"><%= q.points %>đ</span></div>
    <% if(q.questionType==='FILL_BLANK'){ %><div class="small text-success mt-2">Đáp án: <strong><%= q.correctAnswer %></strong></div><% } else if(q.questionType==='ESSAY'){ %><div class="small text-primary mt-2">Tự luận • Giáo viên chấm thủ công</div><% if(q.correctAnswer){ %><div class="small text-secondary mt-1">Gợi ý: <%= q.correctAnswer %></div><% } %><% } else { %><div class="mt-2"><% q.options.forEach(o=>{ %><div class="small <%= o.isCorrect?'text-success fw-semibold':'text-secondary' %>"><%= o.optionKey %>. <%= o.optionText %> <%= o.isCorrect?'✓':'' %></div><% }) %></div><% } %>
    <% if(q.questionType!=='ESSAY'){ %><div class="mt-3"><div class="d-flex justify-content-between small text-secondary mb-1"><span>Tỷ lệ trả lời đúng</span><strong><%= q.accuracy==null?'Chưa có dữ liệu':q.accuracy+'%' %></strong></div><div class="progress skill-progress"><div class="progress-bar" style="width:<%= q.accuracy||0 %>%"></div></div><div class="small text-secondary mt-1"><%= q.correctCount||0 %>/<%= q.answeredCount||0 %> lượt đúng</div></div><% } %>
  </div><% }) %></div></div></div>
  <div class="col-xl-5"><div class="card app-card"><div class="card-header"><strong>Kết quả học sinh</strong></div><div class="card-body p-0"><% if(!exam.attempts.length){ %><div class="text-center text-secondary py-5">Chưa có lượt làm bài.</div><% } %><% exam.attempts.forEach(a=>{ const pending=a.status==='PENDING_GRADING'; const passed=!pending&&a.score!=null&&a.maxScore>0&&(Number(a.score)/Number(a.maxScore)*100>=Number(exam.passScorePercent||50)); %><div class="p-3 border-bottom"><div class="d-flex justify-content-between gap-2"><div><strong><%= a.studentName %></strong><div class="small text-secondary">Lần <%= a.attemptNo %> • <%= pending?'Chờ chấm tự luận':a.status %></div></div><div class="text-end"><strong><%= pending?`Tạm tính ${a.autoScore||0}/${a.maxScore}`:(a.score==null?'—':`${a.score}/${a.maxScore}`) %></strong><% if(!pending&&a.score!=null){ %><div class="small <%= passed?'text-success':'text-danger' %>"><%= passed?'Đạt':'Chưa đạt' %></div><% } %></div></div><% if((pending||a.status==='GRADED')&&exam.hasEssay){ %><div class="mt-2"><a class="btn btn-sm <%= pending?'btn-warning':'btn-outline-primary' %>" href="/exams/<%= exam.id %>/attempts/<%= a.id %>/grade"><%= pending?'Chấm tự luận':'Xem / chấm lại' %></a></div><% } %></div><% }) %></div></div></div>
</div>

<div class="card app-card mt-4"><div class="card-header"><strong>Thiết lập riêng cho học sinh</strong><div class="small text-secondary">Gia hạn thời gian, tăng số lần làm hoặc mở lại đề cho từng học sinh.</div></div><div class="card-body p-0"><% if(!exam.classStudents?.length){ %><div class="p-4 text-secondary">Lớp chưa có học sinh.</div><% } %><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Học sinh</th><th>Thêm phút</th><th>Số lần tối đa</th><th>Mở lại đến</th><th></th></tr></thead><tbody><% exam.classStudents?.forEach(s=>{ const o=s.override||{}; const reopen=o.reopenUntil?new Date(o.reopenUntil).toISOString().slice(0,16):''; const formId=`override-${s.id}`; %><tr><td><strong><%= s.fullName %></strong><form id="<%= formId %>" method="post" action="/exams/<%= exam.id %>/overrides"><input type="hidden" name="studentId" value="<%= s.id %>"></form></td><td style="min-width:110px"><input form="<%= formId %>" class="form-control form-control-sm" type="number" min="0" max="1440" name="extraMinutes" value="<%= o.extraMinutes||0 %>"></td><td style="min-width:120px"><input form="<%= formId %>" class="form-control form-control-sm" type="number" min="1" max="20" name="maxAttemptsOverride" placeholder="Mặc định" value="<%= o.maxAttemptsOverride||'' %>"></td><td style="min-width:210px"><input form="<%= formId %>" class="form-control form-control-sm" type="datetime-local" name="reopenUntil" value="<%= reopen %>"></td><td><button form="<%= formId %>" class="btn btn-sm btn-outline-primary">Lưu</button></td></tr><% }) %></tbody></table></div></div></div>
<%- include('../partials/app-end') %>
