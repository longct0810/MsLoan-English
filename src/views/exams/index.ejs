<%- include('../partials/app-start', { title }) %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><h1 class="h3 mb-1">Kiểm tra trực tuyến</h1><p class="text-secondary mb-0">Tạo đề từ ngân hàng câu hỏi và theo dõi kết quả.</p></div><div class="d-flex gap-2"><a href="/questions" class="btn btn-outline-primary">Ngân hàng câu hỏi</a><a href="/exams/new" class="btn btn-primary">+ Tạo bài kiểm tra</a></div></div>
<div class="row g-3">
<% if(!exams.length){ %><div class="col-12"><div class="card app-card"><div class="card-body text-center py-5 text-secondary">Chưa có bài kiểm tra.</div></div></div><% } %>
<% exams.forEach(e=>{ %><div class="col-xl-6"><div class="card app-card h-100"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><div><div class="small text-secondary"><%= e.className %> • Khối <%= e.grade %></div><h2 class="h5 mt-1"><%= e.title %></h2></div><span class="badge align-self-start <%= e.status==='PUBLISHED'?'text-bg-success':e.status==='CLOSED'?'text-bg-secondary':'text-bg-warning' %>"><%= e.status==='PUBLISHED'?'Đã mở':e.status==='CLOSED'?'Đã đóng':'Bản nháp' %></span></div><div class="row g-2 mt-2 small"><div class="col-6">Câu hỏi: <strong><%= e.questionCount %></strong></div><div class="col-6">Thời gian: <strong><%= e.durationMinutes %> phút</strong></div><div class="col-6">Đã nộp: <strong><%= e.submitted %></strong></div><div class="col-6">Điểm TB: <strong><%= e.averageScore==null?'—':Number(e.averageScore).toFixed(1) %></strong></div><% if(e.pendingGrading){ %><div class="col-12 text-warning">Chờ chấm tự luận: <strong><%= e.pendingGrading %></strong></div><% } %></div><div class="mt-3"><a href="/exams/<%= e.id %>" class="btn btn-sm btn-outline-primary">Mở bài kiểm tra</a></div></div></div></div><% }) %>
</div>
<%- include('../partials/app-end') %>
