<%- include('../partials/app-start', { title }) %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Tạo bài kiểm tra</h1><p class="text-secondary mb-0">Chọn câu hỏi đã xuất bản từ Question Bank.</p></div><a href="/exams" class="btn btn-outline-secondary">Quay lại</a></div>
<% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="post" action="<%= exam ? `/exams/${exam.id}/update` : '/exams' %>" id="examForm"><div class="row g-4"><div class="col-xl-5"><div class="card app-card"><div class="card-body p-4"><h2 class="h5 mb-3">Thông tin đề</h2><div class="mb-3"><label class="form-label">Lớp *</label><select class="form-select" name="classId" id="classId" required><option value="">-- Chọn lớp --</option><% classes.forEach(c=>{ %><option value="<%= c.id %>" data-grade="<%= c.grade %>" <%= String(form?.classId||'')===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></div><div class="mb-3"><label class="form-label">Tên bài kiểm tra *</label><input class="form-control" name="title" required value="<%= form?.title||'' %>"></div><div class="mb-3"><label class="form-label">Mô tả</label><textarea class="form-control" name="description" rows="2"><%= form?.description||'' %></textarea></div><div class="mb-3"><label class="form-label">Hướng dẫn</label><textarea class="form-control" name="instructions" rows="3"><%= form?.instructions||'' %></textarea></div><div class="row g-3"><div class="col-6"><label class="form-label">Thời gian</label><div class="input-group"><input class="form-control" type="number" min="1" max="<%= examConfig.maxDurationMinutes %>" name="durationMinutes" value="<%= form?.durationMinutes||examConfig.defaultDurationMinutes %>"><span class="input-group-text">phút</span></div></div><div class="col-6"><label class="form-label">Số lần làm</label><input class="form-control" type="number" min="1" max="<%= examConfig.maxAttempts %>" name="maxAttempts" value="<%= form?.maxAttempts||examConfig.defaultMaxAttempts %>"></div><div class="col-12"><label class="form-label">Mở đề</label><input class="form-control" type="datetime-local" name="startAt" value="<%= form?.startAt||'' %>"></div><div class="col-12"><label class="form-label">Đóng đề</label><input class="form-control" type="datetime-local" name="endAt" value="<%= form?.endAt||'' %>"></div></div><div class="form-check form-switch mt-3"><input type="hidden" name="showResult" value="0"><input class="form-check-input" type="checkbox" name="showResult" id="showResult" <%= form?.showResult!==undefined ? (form.showResult?'checked':'') : 'checked' %>><label class="form-check-label" for="showResult">Cho học sinh xem đáp án/kết quả sau khi nộp</label></div></div></div></div>
<div class="col-xl-7"><div class="card app-card"><div class="card-header d-flex align-items-center justify-content-between"><div><strong>Chọn câu hỏi</strong><div class="small text-secondary">Chỉ hiển thị câu phù hợp với khối của lớp đã chọn.</div></div><span class="badge text-bg-primary" id="selectedCount">0 câu</span></div><div class="card-body p-0 exam-question-picker"><% questions.forEach(q=>{ %><label class="question-pick-row d-flex gap-3 p-3 border-bottom" data-grade="<%= q.grade||'' %>"><input class="form-check-input mt-1 question-check" type="checkbox" name="questionIds" value="<%= q.id %>" <%= (Array.isArray(form?.questionIds)?form.questionIds:[form?.questionIds]).map(String).includes(String(q.id))?'checked':'' %>><div class="flex-grow-1"><div class="fw-semibold"><%= q.stem %></div><div class="small text-secondary mt-1">Khối <%= q.grade||'—' %> • <%= {MULTIPLE_CHOICE:'Trắc nghiệm',TRUE_FALSE:'Đúng/Sai',FILL_BLANK:'Điền từ'}[q.questionType] %> • <%= q.difficulty %> • <%= q.defaultPoints %> điểm</div></div></label><% }) %><div class="p-4 text-center text-secondary d-none" id="noQuestions">Không có câu hỏi đã xuất bản phù hợp.</div></div></div><button class="btn btn-primary mt-3 w-100"><%= exam ? 'Cập nhật bản nháp' : 'Lưu bản nháp' %></button></div></div></form>
<script>(function(){const cls=document.getElementById('classId'),rows=[...document.querySelectorAll('.question-pick-row')],checks=[...document.querySelectorAll('.question-check')],count=document.getElementById('selectedCount'),empty=document.getElementById('noQuestions');function update(){const grade=cls.selectedOptions[0]?.dataset.grade||'';let visible=0;rows.forEach(r=>{const show=!grade||r.dataset.grade===grade;r.classList.toggle('d-none',!show);if(show)visible++;});empty.classList.toggle('d-none',visible>0);count.textContent=`${checks.filter(x=>x.checked).length} câu`;}cls.addEventListener('change',update);checks.forEach(x=>x.addEventListener('change',update));update();})();</script>
<%- include('../partials/app-end') %>
