<%- include('../partials/app-start', { title }) %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><div class="small text-secondary"><%= attempt.exam.title %> • Lần <%= attempt.attemptNo %></div><h1 class="h3 mb-1">Chấm bài: <%= attempt.studentName %></h1><p class="text-secondary mb-0">Phần khách quan đã được hệ thống tự chấm. Giáo viên nhập điểm và phản hồi cho các câu tự luận.</p></div><a href="/exams/<%= attempt.exam.id %>" class="btn btn-outline-secondary">Quay lại bài kiểm tra</a></div>
<% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><div class="metric-label">Điểm tự động</div><div class="metric-value"><%= attempt.autoScore||0 %></div><div class="metric-meta">Phần khách quan</div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-label">Điểm tối đa</div><div class="metric-value"><%= attempt.maxScore||attempt.exam.totalPoints %></div><div class="metric-meta">Toàn bộ đề</div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-label">Trạng thái</div><div class="h5 mt-2"><%= attempt.status==='PENDING_GRADING'?'Chờ giáo viên chấm':attempt.status %></div></div></div></div>
<form method="post" action="/exams/<%= attempt.exam.id %>/attempts/<%= attempt.id %>/grade">
<% attempt.essayQuestions.forEach((q,i)=>{ const ans=q.answer||{}; %><div class="card app-card mb-4"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><h2 class="h5">Câu tự luận <%= i+1 %>. <%= q.stem %></h2><span class="badge text-bg-light border"><%= q.points %> điểm</span></div><div class="mt-3"><div class="small text-secondary mb-1">Bài làm học sinh</div><div class="p-3 bg-light rounded" style="white-space:pre-wrap;min-height:90px"><%= ans.answerText||'Học sinh không trả lời.' %></div></div><% if(q.correctAnswer){ %><div class="alert alert-light border mt-3"><strong>Đáp án/gợi ý tham khảo:</strong><br><%= q.correctAnswer %></div><% } %><% if(q.explanation){ %><div class="small text-secondary mt-2"><strong>Hướng dẫn chấm:</strong> <%= q.explanation %></div><% } %><div class="row g-3 mt-2"><div class="col-md-3"><label class="form-label">Điểm *</label><input class="form-control" type="number" name="score_<%= q.id %>" min="0" max="<%= q.points %>" step="0.25" required value="<%= ans.awardedScore==null?'':ans.awardedScore %>"><div class="form-text">Tối đa <%= q.points %></div></div><div class="col-md-9"><label class="form-label">Nhận xét giáo viên</label><textarea class="form-control" name="feedback_<%= q.id %>" rows="3" placeholder="Nhận xét về nội dung, ngữ pháp, từ vựng..."><%= ans.teacherFeedback||'' %></textarea></div></div></div></div><% }) %>
<% if(!attempt.essayQuestions.length){ %><div class="alert alert-info">Bài kiểm tra này không có câu tự luận.</div><% } else { %><div class="d-flex justify-content-end gap-2"><a href="/exams/<%= attempt.exam.id %>" class="btn btn-outline-secondary">Hủy</a><button class="btn btn-primary btn-lg">Lưu điểm & hoàn tất chấm</button></div><% } %>
</form>
<%- include('../partials/app-end') %>
