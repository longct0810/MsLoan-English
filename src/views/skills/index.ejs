<%- include('../partials/app-start',{title}) %>
<div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4"><div><h1 class="h3 mb-1">Theo dõi kỹ năng</h1><div class="text-secondary">Tổng hợp kỹ năng từ bài tập và bài kiểm tra đã chấm.</div></div><form class="d-flex gap-2" method="get"><select class="form-select" name="classId"><option value="">Tất cả lớp</option><% classes.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(selectedClassId)===Number(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><button class="btn btn-primary">Lọc</button></form></div>
<div class="card app-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Học viên</th><th>Lớp</th><% skills.forEach(sk=>{ %><th class="text-center"><%= sk.label %></th><% }) %></tr></thead><tbody><% students.forEach(st=>{ const map=new Map((st.skills||[]).map(x=>[String(x.skill).toUpperCase(),Number(x.score)])); %><tr><td class="fw-semibold"><%= st.fullName %></td><td><%= st.className %></td><% skills.forEach(sk=>{ const score=map.get(sk.code); %><td class="text-center"><%= Number.isFinite(score)?score.toFixed(1):'—' %></td><% }) %></tr><% }) %></tbody></table></div></div>
<%- include('../partials/app-end') %>
