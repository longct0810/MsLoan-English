<%- include('head', { title }) %>
<%
  const role = currentUser?.role || '';
  const isTeacher = ['TEACHER', 'ADMIN'].includes(role);
  const canManageDataSources = role === 'TEACHER';
  const isStudent = role === 'STUDENT';
  const isParent = role === 'PARENT';
  const homeUrl = isStudent ? '/student' : (isParent ? '/parent' : '/dashboard');
  const workspaceLabel = isStudent ? 'Student portal' : (isParent ? 'Parent portal' : 'Teacher workspace');
  const avatarClass = isStudent ? 'student-avatar' : (isParent ? 'parent-avatar' : 'teacher-avatar');
%>
<div class="app-shell">
  <aside class="sidebar d-none d-lg-flex flex-column">
    <a href="<%= homeUrl %>" class="brand text-decoration-none">
      <span class="brand-mark"><%= appShortName %></span>
      <span>
        <strong><%= appName %></strong>
        <small><%= workspaceLabel %></small>
      </span>
    </a>

    <nav class="nav flex-column gap-1 mt-4" aria-label="Điều hướng chính">
      <% if (isTeacher) { %>
        <div class="nav-section-label">Lớp học</div>
        <a class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard">Tổng quan</a>
        <a class="nav-link <%= currentPath.startsWith('/classes') ? 'active' : '' %>" href="/classes">Lớp học</a>
        <a class="nav-link <%= currentPath.startsWith('/students') ? 'active' : '' %>" href="/students">Học viên</a>
        <a class="nav-link <%= currentPath.startsWith('/sessions') ? 'active' : '' %>" href="/sessions">Buổi học & điểm danh</a>
        <% if (canManageDataSources) { %><a class="nav-link <%= currentPath.startsWith('/teacher/data-sources') ? 'active' : '' %>" href="/teacher/data-sources">Nguồn dữ liệu</a><% } %>
        <% if (role === 'TEACHER') { %><a class="nav-link <%= currentPath.startsWith('/teacher/tuition') ? 'active' : '' %>" href="/teacher/tuition">Học phí & QR</a><% } %>
        <div class="nav-section-label mt-3">Nội dung & đánh giá</div>
        <a class="nav-link <%= currentPath.startsWith('/lessons') ? 'active' : '' %>" href="/lessons">Bài học & tài liệu</a>
        <a class="nav-link <%= currentPath.startsWith('/assignments') ? 'active' : '' %>" href="/assignments">Bài tập & chấm bài</a>
        <a class="nav-link <%= currentPath.startsWith('/questions') ? 'active' : '' %>" href="/questions">Ngân hàng câu hỏi</a>
        <a class="nav-link <%= currentPath.startsWith('/exams') ? 'active' : '' %>" href="/exams">Kiểm tra</a>
        <a class="nav-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>" href="/reports">Báo cáo</a>
        <a class="nav-link <%= currentPath.startsWith('/skills') ? 'active' : '' %>" href="/skills">Theo dõi kỹ năng</a>
      <% } %>

      <% if (isStudent) { %>
        <a class="nav-link <%= currentPath === '/student' ? 'active' : '' %>" href="/student">Trang chủ</a>
        <a class="nav-link <%= currentPath.startsWith('/student/assignments') ? 'active' : '' %>" href="/student/assignments">Bài tập</a>
        <a class="nav-link <%= currentPath.startsWith('/student/materials') ? 'active' : '' %>" href="/student/materials">Tài liệu</a>
        <a class="nav-link <%= currentPath.startsWith('/student/progress') ? 'active' : '' %>" href="/student/progress">Tiến độ</a>
        <a class="nav-link <%= currentPath.startsWith('/student/exams') || currentPath.startsWith('/student/exam-attempts') ? 'active' : '' %>" href="/student/exams">Kiểm tra</a>
      <% } %>

      <% if (isParent) { %>
        <a class="nav-link <%= currentPath === '/parent' ? 'active' : '' %>" href="/parent">Tổng quan</a>
        <a class="nav-link <%= currentPath.startsWith('/parent/progress') ? 'active' : '' %>" href="/parent/progress">Kết quả học tập</a>
        <a class="nav-link <%= currentPath.startsWith('/parent/reports') ? 'active' : '' %>" href="/parent/reports">Báo cáo học tập</a>
        <a class="nav-link <%= currentPath.startsWith('/parent/notifications') ? 'active' : '' %>" href="/parent/notifications">Thông báo</a>
        <a class="nav-link <%= currentPath.startsWith('/parent/tuition') ? 'active' : '' %>" href="/parent/tuition">Học phí</a>
      <% } %>
    </nav>

  </aside>

  <main class="app-main">
    <nav class="navbar bg-white border-bottom sticky-top px-3 px-lg-4">
      <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">☰</button>
      <div class="ms-2 ms-lg-0">
        <div class="text-secondary small"><%= appName %></div>
        <strong><%= title %></strong>
      </div>
      <div class="ms-auto dropdown account-menu">
        <button
          class="btn account-menu-toggle d-flex align-items-center gap-2"
          type="button"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          aria-label="Mở menu tài khoản"
        >
          <span class="<%= avatarClass %>"><%= currentUser.fullName.charAt(0) %></span>
          <span class="account-menu-summary d-none d-sm-block text-start">
            <span class="account-menu-name"><%= currentUser.fullName %></span>
            <span class="account-menu-role"><%= role %></span>
          </span>
          <span class="account-menu-caret" aria-hidden="true">⌄</span>
        </button>

        <div class="dropdown-menu dropdown-menu-end account-dropdown shadow-sm">
          <div class="px-3 py-2">
            <div class="small text-secondary">Đăng nhập bởi</div>
            <div class="fw-semibold text-break"><%= currentUser.fullName %></div>
            <div class="small text-secondary text-break">@<%= currentUser.username %></div>
            <div class="d-flex align-items-center justify-content-between gap-3 mt-1">
              <span class="small text-secondary"><%= role %></span>
              <span class="badge rounded-pill text-bg-light border">v<%= appVersion %></span>
            </div>
          </div>
          <div class="dropdown-divider"></div>
          <a class="dropdown-item <%= currentPath.startsWith('/account/password') ? 'active' : '' %>" href="/account/password">
            Đổi mật khẩu
          </a>
          <form method="post" action="/logout" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="dropdown-item text-danger" type="submit">Đăng xuất</button>
          </form>
        </div>
      </div>
    </nav>

    <% if (demoMode) { %>
      <div class="alert alert-danger rounded-0 border-start-0 border-end-0 mb-0 py-2 px-3 px-lg-4" role="alert">
        <strong>DEMO MODE đang bật:</strong> thay đổi Học viên/Lớp chỉ lưu trong bộ nhớ của tiến trình và <strong>không ghi PostgreSQL/Neon</strong>. Không sử dụng chế độ này cho dữ liệu thật.
      </div>
    <% } %>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title"><%= appName %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body">
        <div class="nav flex-column gap-2">
          <% if (isTeacher) { %>
            <div class="nav-section-label">Lớp học</div>
            <a class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard">Tổng quan</a>
            <a class="nav-link <%= currentPath.startsWith('/classes') ? 'active' : '' %>" href="/classes">Lớp học</a>
            <a class="nav-link <%= currentPath.startsWith('/students') ? 'active' : '' %>" href="/students">Học viên</a>
            <a class="nav-link <%= currentPath.startsWith('/sessions') ? 'active' : '' %>" href="/sessions">Buổi học & điểm danh</a>
            <% if (canManageDataSources) { %><a class="nav-link <%= currentPath.startsWith('/teacher/data-sources') ? 'active' : '' %>" href="/teacher/data-sources">Nguồn dữ liệu</a><% } %>
            <% if (role === 'TEACHER') { %><a class="nav-link <%= currentPath.startsWith('/teacher/tuition') ? 'active' : '' %>" href="/teacher/tuition">Học phí & QR</a><% } %>
            <div class="nav-section-label mt-3">Nội dung & đánh giá</div>
            <a class="nav-link <%= currentPath.startsWith('/lessons') ? 'active' : '' %>" href="/lessons">Bài học & tài liệu</a>
            <a class="nav-link <%= currentPath.startsWith('/assignments') ? 'active' : '' %>" href="/assignments">Bài tập & chấm bài</a>
            <a class="nav-link <%= currentPath.startsWith('/questions') ? 'active' : '' %>" href="/questions">Ngân hàng câu hỏi</a>
            <a class="nav-link <%= currentPath.startsWith('/exams') ? 'active' : '' %>" href="/exams">Kiểm tra</a>
            <a class="nav-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>" href="/reports">Báo cáo</a>
        <a class="nav-link <%= currentPath.startsWith('/skills') ? 'active' : '' %>" href="/skills">Theo dõi kỹ năng</a>
          <% } %>
          <% if (isStudent) { %>
            <a class="nav-link" href="/student">Trang chủ</a>
            <a class="nav-link" href="/student/assignments">Bài tập</a>
            <a class="nav-link" href="/student/materials">Tài liệu</a>
            <a class="nav-link" href="/student/progress">Tiến độ</a>
            <a class="nav-link" href="/student/exams">Kiểm tra</a>
          <% } %>
          <% if (isParent) { %>
            <a class="nav-link" href="/parent">Tổng quan</a>
            <a class="nav-link" href="/parent/progress">Kết quả học tập</a>
            <a class="nav-link <%= currentPath.startsWith('/parent/reports') ? 'active' : '' %>" href="/parent/reports">Báo cáo học tập</a>
            <a class="nav-link <%= currentPath.startsWith('/parent/notifications') ? 'active' : '' %>" href="/parent/notifications">Thông báo</a>
            <a class="nav-link <%= currentPath.startsWith('/parent/tuition') ? 'active' : '' %>" href="/parent/tuition">Học phí</a>
          <% } %>
        </div>
      </div>
    </div>

    <div class="container-fluid p-3 p-lg-4 page-content">
