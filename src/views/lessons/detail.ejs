<%- include('../partials/app-start', { title }) %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
  <div class="d-flex gap-3 align-items-start">
    <a href="/lessons" class="btn btn-outline-secondary">←</a>
    <div>
      <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
        <span class="lesson-unit"><%= lesson.unitName || `Khối ${lesson.grade}` %></span>
        <span class="badge <%= lesson.status === 'PUBLISHED' ? 'text-bg-success' : 'text-bg-warning' %>"><%= lesson.status === 'PUBLISHED' ? 'Đã xuất bản' : 'Bản nháp' %></span>
      </div>
      <h1 class="h3 mb-1"><%= lesson.title %></h1>
      <p class="text-secondary mb-0"><%= lesson.className %></p>
    </div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-secondary" href="/lessons/<%= lesson.id %>/edit">Sửa bài học</a>
    <a class="btn btn-outline-primary" href="/assignments/new?classId=<%= lesson.classId %>&lessonId=<%= lesson.id %>">+ Giao bài tập</a>
    <% if (lesson.status !== 'PUBLISHED') { %>
      <form method="post" action="/lessons/<%= lesson.id %>/publish"><button class="btn btn-primary">Xuất bản bài học</button></form>
    <% } %>
  </div>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div class="row g-4">
  <div class="col-xl-8">
    <div class="card app-card mb-4">
      <div class="card-header"><strong>Nội dung bài học</strong></div>
      <div class="card-body p-4">
        <% if (lesson.summary) { %><p class="lead fs-6"><%= lesson.summary %></p><% } %>
        <div class="lesson-content"><%= lesson.content || 'Chưa nhập nội dung chi tiết.' %></div>
      </div>
    </div>

    <div class="card app-card" id="materials">
      <div class="card-header d-flex justify-content-between align-items-center"><strong>Tài liệu học tập</strong><span class="badge text-bg-light"><%= lesson.materials.length %> tài liệu</span></div>
      <div class="card-body p-0">
        <% if (!lesson.materials.length) { %><div class="p-4 text-secondary">Chưa có tài liệu cho bài học này.</div><% } %>
        <% lesson.materials.forEach(material => { %>
          <div class="p-3 p-lg-4 border-bottom d-flex flex-column flex-md-row gap-3 align-items-md-center">
            <div class="material-type"><%= material.type %></div>
            <div class="flex-grow-1">
              <strong><%= material.title %></strong>
              <% if (material.description) { %><div class="small text-secondary mt-1"><%= material.description %></div><% } %>
              <div class="small text-secondary mt-1"><%= material.status %></div>
            </div>
            <% if (material.resourceUrl) { %><a target="_blank" rel="noopener" href="<%= material.resourceUrl %>" class="btn btn-outline-primary">Mở</a><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="col-xl-4">
    <div class="card app-card mb-4">
      <div class="card-header"><strong>Thêm tài liệu</strong></div>
      <div class="card-body">
        <form method="post" action="/lessons/<%= lesson.id %>/materials">
          <div class="mb-3"><label class="form-label">Tên tài liệu *</label><input class="form-control" name="title" required></div>
          <div class="row g-2 mb-3">
            <div class="col-6"><label class="form-label">Loại</label><select class="form-select" name="type"><option>PDF</option><option>AUDIO</option><option>VIDEO</option><option>LINK</option><option>FLASHCARD</option><option>IMAGE</option></select></div>
            <div class="col-6"><label class="form-label">Trạng thái</label><select class="form-select" name="status"><option value="PUBLISHED">Công khai</option><option value="DRAFT">Bản nháp</option></select></div>
          </div>
          <div class="mb-3"><label class="form-label">URL tài liệu</label><input class="form-control" type="url" name="resourceUrl" placeholder="https://..."></div>
          <div class="mb-3"><label class="form-label">Mô tả</label><textarea class="form-control" rows="3" name="description"></textarea></div>
          <button class="btn btn-primary w-100">Thêm tài liệu</button>
        </form>
      </div>
    </div>

    <div class="card app-card">
      <div class="card-header"><strong>Bài tập liên quan</strong></div>
      <div class="card-body p-0">
        <% if (!lesson.assignments.length) { %><div class="p-3 text-secondary small">Chưa có bài tập.</div><% } %>
        <% lesson.assignments.forEach(a => { %><a class="d-block p-3 border-bottom text-decoration-none text-reset" href="/assignments/<%= a.id %>"><strong class="d-block"><%= a.title %></strong><span class="small text-secondary"><%= a.status %> • <%= a.type %></span></a><% }) %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/app-end') %>
