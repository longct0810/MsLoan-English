<%- include('../partials/app-start', { title }) %>
<div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
  <div><h1 class="h3 mb-1">Quản lý lớp học</h1><p class="text-secondary mb-0">Thêm, chỉnh sửa và quản lý các lớp tiếng Anh khối 6–9.</p></div>
  <a class="btn btn-primary align-self-md-start" href="/classes/new">+ Thêm lớp</a>
</div>
<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
<div class="row g-3">
  <% if (!classes.length) { %><div class="col-12"><div class="card app-card"><div class="card-body text-center py-5 text-secondary">Chưa có lớp học.</div></div></div><% } %>
  <% classes.forEach(c => { %>
    <div class="col-md-6 col-xl-4">
      <div class="card class-card h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-4">
            <span class="grade-pill large">G<%= c.grade %></span>
            <span class="badge <%= c.status === 'ACTIVE' ? 'text-bg-success-subtle text-success-emphasis' : 'text-bg-secondary-subtle text-secondary-emphasis' %>"><%= c.status === 'ACTIVE' ? 'Đang học' : 'Tạm dừng' %></span>
          </div>
          <a href="/classes/<%= c.id %>" class="text-decoration-none"><h2 class="h5 text-body"><%= c.name %></h2></a>
          <div class="text-secondary small mb-3"><%= c.schedule || 'Chưa cấu hình lịch học' %></div>
          <div class="d-flex justify-content-between border-top pt-3 text-body mb-3"><span><strong><%= c.studentCount %></strong> học viên</span><span class="text-secondary"><%= c.schoolYear %></span></div>
          <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-primary flex-grow-1" href="/classes/<%= c.id %>">Mở lớp</a>
            <a class="btn btn-sm btn-outline-secondary" href="/classes/<%= c.id %>/edit">Sửa</a>
            <form method="post" action="/classes/<%= c.id %>/delete" onsubmit="return confirm('Xóa lớp này khỏi danh sách sử dụng? Dữ liệu bài học, điểm và lịch sử vẫn được giữ lại.');"><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include('../partials/app-end') %>
