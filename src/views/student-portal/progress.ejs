<%- include('../partials/app-start', { title }) %>
<div class="mb-4"><h1 class="h3 mb-1">Tiến độ học tập</h1><p class="text-secondary mb-0">Theo dõi kết quả và năng lực theo từng kỹ năng tiếng Anh.</p></div>

<div class="row g-4">
  <div class="col-xl-5">
    <div class="card app-card mb-4">
      <div class="card-header"><strong>6 kỹ năng</strong></div>
      <div class="card-body">
        <% portal.skills.forEach(skill => { %>
          <div class="skill-row mb-4">
            <div class="d-flex justify-content-between mb-2"><span class="fw-semibold"><%= skill.skill %></span><strong><%= skill.score %>/10</strong></div>
            <div class="progress skill-progress lg"><div class="progress-bar" style="width:<%= skill.score * 10 %>%"></div></div>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="card app-card">
      <div class="card-header"><strong>Chuyên cần gần đây</strong></div>
      <div class="card-body">
        <% portal.attendance.forEach(a => { %>
          <div class="d-flex justify-content-between align-items-center gap-3 py-2 border-bottom"><span><%= new Date(a.date).toLocaleDateString('vi-VN') %><% if (a.topic) { %><div class="small text-secondary"><%= a.topic %></div><% } %></span><span class="badge <%= a.statusMeta.className %>"><%= a.statusMeta.label %></span></div>
        <% }) %>
      </div>
    </div>
  </div>
  <div class="col-xl-7">
    <div class="card app-card">
      <div class="card-header"><strong>Lịch sử điểm</strong><div class="small text-secondary">Các bài đã được giáo viên ghi nhận</div></div>
      <div class="table-responsive">
        <table class="table align-middle mb-0"><thead><tr><th>Ngày</th><th>Bài</th><th>Kỹ năng</th><th>Điểm</th></tr></thead><tbody>
          <% portal.scores.forEach(s => { %><tr><td><%= new Date(s.recordedAt).toLocaleDateString('vi-VN') %></td><td class="fw-semibold"><%= s.title %></td><td><%= s.category %></td><td><% const normalizedScore = s.maxScore ? (s.score / s.maxScore) * 10 : s.score; %><span class="score-badge <%= normalizedScore >= 8 ? 'good' : (normalizedScore < 7 ? 'warn' : '') %>"><%= s.score %><%= s.maxScore && s.maxScore !== 10 ? '/' + s.maxScore : '' %></span></td></tr><% }) %>
        </tbody></table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/app-end') %>
