<%- include('../../partials/app-start', { title }) %>
<div class="exam-taking-bar sticky-top bg-white border rounded-3 p-3 mb-4 shadow-sm" style="top:82px;z-index:1010"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong><%= attempt.exam.title %></strong><div class="small text-secondary">Lần làm <%= attempt.attemptNo %> • <%= attempt.exam.questions.length %> câu</div></div><div class="d-flex align-items-center gap-3"><span id="saveState" class="small text-secondary">Tự động lưu</span><span class="exam-timer" id="timer">--:--</span></div></div></div>
<form method="post" action="/student/exam-attempts/<%= attempt.id %>/submit" id="attemptForm"><input type="hidden" name="autoSubmitted" id="autoSubmitted" value="0">
<div class="row justify-content-center"><div class="col-xl-9">
<% attempt.exam.questions.forEach((q,i)=>{ %>
  <div class="card app-card mb-3 exam-question-card" data-question="<%= q.id %>"><div class="card-body p-4">
    <div class="d-flex justify-content-between gap-3 mb-3"><h2 class="h6 mb-0">Câu <%= i+1 %>. <%= q.stem %></h2><span class="badge text-bg-light border"><%= q.points %> điểm</span></div>
    <% if(q.questionType==='FILL_BLANK'){ %>
      <input class="form-control exam-answer-input" name="answer_<%= q.id %>" data-question-id="<%= q.id %>" data-answer-kind="text" type="text" value="<%= q.answer.answerText||'' %>" placeholder="Nhập đáp án...">
    <% } else if(q.questionType==='ESSAY'){ %>
      <textarea class="form-control exam-answer-input" name="answer_<%= q.id %>" data-question-id="<%= q.id %>" data-answer-kind="text" rows="7" placeholder="Nhập câu trả lời tự luận..."><%= q.answer.answerText||'' %></textarea>
      <div class="form-text">Câu này sẽ được giáo viên chấm sau khi bạn nộp bài.</div>
    <% } else { %>
      <div class="vstack gap-2"><% q.options.forEach(o=>{ %><label class="exam-option"><input class="form-check-input exam-answer-input" type="radio" name="answer_<%= q.id %>" data-question-id="<%= q.id %>" data-answer-kind="option" value="<%= o.id %>" <%= String(q.answer.selectedOptionId||'')===String(o.id)?'checked':'' %>><span><strong><%= o.optionKey %>.</strong> <%= o.optionText %></span></label><% }) %></div>
    <% } %>
  </div></div>
<% }) %>
<div class="card app-card"><div class="card-body p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3"><div><strong>Hoàn thành bài?</strong><div class="small text-secondary">Kiểm tra lại câu trả lời trước khi nộp.</div></div><button class="btn btn-success btn-lg" type="submit" onclick="return confirm('Bạn chắc chắn muốn nộp bài?')">Nộp bài</button></div></div>
</div></div></form>
<script>
(function(){
  const attemptId=<%- JSON.stringify(attempt.id) %>, deadline=new Date(<%- JSON.stringify(attempt.deadline) %>).getTime(), timer=document.getElementById('timer'), state=document.getElementById('saveState'), form=document.getElementById('attemptForm');let submitting=false;const timers=new Map();
  function tick(){const ms=Math.max(0,deadline-Date.now()),total=Math.floor(ms/1000),m=Math.floor(total/60),s=total%60;timer.textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;timer.classList.toggle('text-danger',total<300);if(ms<=0&&!submitting){submitting=true;document.getElementById('autoSubmitted').value='1';form.requestSubmit();}}
  async function save(input){const q=input.dataset.questionId;const payload={questionId:Number(q)};if(input.dataset.answerKind==='option'){if(!input.checked)return;payload.selectedOptionId=Number(input.value);}else payload.answerText=input.value;state.textContent='Đang lưu...';state.classList.remove('text-danger');try{const r=await fetch(`/api/v1/exam-attempts/${attemptId}/answers`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error();state.textContent='Đã lưu';}catch(e){state.textContent='Chưa lưu được';state.classList.add('text-danger');}}
  document.querySelectorAll('.exam-answer-input').forEach(input=>{const evt=input.dataset.answerKind==='text'?'input':'change';input.addEventListener(evt,()=>{const key=input.dataset.questionId;clearTimeout(timers.get(key));timers.set(key,setTimeout(()=>save(input),input.dataset.answerKind==='text'?<%= examConfig.autosaveDebounceMs %>:50));});});
  form.addEventListener('submit',()=>{submitting=true;});tick();setInterval(tick,1000);
})();
</script>
<%- include('../../partials/app-end') %>
