<%- include('../../partials/app-start', { title }) %>
<div class="mb-4"><h1 class="h3 mb-1">Bài kiểm tra</h1><p class="text-secondary mb-0">Làm bài trực tuyến, hệ thống tự lưu đáp án trong quá trình làm.</p></div>
<% if(error){ %><div class="alert alert-warning"><%= error %></div><% } %>
<div class="row g-3"><% if(!exams.length){ %><div class="col-12"><div class="card app-card"><div class="card-body text-center py-5 text-secondary">Hiện chưa có bài kiểm tra.</div></div></div><% } %><% exams.forEach(e=>{ const open=e.availability==='OPEN'; %><div class="col-lg-6"><div class="card app-card h-100"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><div><div class="small text-secondary"><%= e.className %></div><h2 class="h5 mt-1"><%= e.title %></h2></div><span class="badge align-self-start <%= open?'text-bg-success':e.availability==='UPCOMING'?'text-bg-info':e.availability==='DONE'?'text-bg-primary':'text-bg-secondary' %>"><%= {OPEN:'Có thể làm',UPCOMING:'Sắp mở',CLOSED:'Đã đóng',DONE:'Đã hoàn thành'}[e.availability] %></span></div><p class="text-secondary"><%= e.description||'Bài kiểm tra trực tuyến.' %></p><div class="row small g-2 mb-3"><div class="col-6">Thời gian: <strong><%= e.durationMinutes %> phút</strong></div><div class="col-6">Số lần: <strong><%= e.attempts %>/<%= e.maxAttempts %></strong></div><div class="col-12">Mở: <strong><%= e.startAt?new Date(e.startAt).toLocaleString('vi-VN'):'Ngay khi được giao' %></strong></div></div><% if(e.lastStatus==='IN_PROGRESS' && e.lastAttemptId){ %><a href="/student/exam-attempts/<%= e.lastAttemptId %>" class="btn btn-primary">Tiếp tục làm bài</a><% } else if(open){ %><form method="post" action="/student/exams/<%= e.id %>/start"><button class="btn btn-primary">Bắt đầu làm bài</button></form><% } else if(e.lastAttemptId && e.lastStatus!=='IN_PROGRESS'){ %><a href="/student/exam-attempts/<%= e.lastAttemptId %>/result" class="btn btn-outline-primary">Xem kết quả</a><% } %></div></div></div><% }) %></div>
<%- include('../../partials/app-end') %>
