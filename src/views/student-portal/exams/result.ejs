<%- include('../../partials/app-start', { title }) %>
<div class="result-hero p-4 mb-4 text-center"><div class="eyebrow">KẾT QUẢ BÀI KIỂM TRA</div><h1 class="h3"><%= attempt.exam.title %></h1><div class="display-5 fw-bold text-primary my-3"><%= attempt.score %>/<%= attempt.maxScore %></div><div class="text-secondary">Nộp lúc <%= attempt.submittedAt?new Date(attempt.submittedAt).toLocaleString('vi-VN'):'—' %></div></div>
<% if(attempt.exam.showResult){ %><div class="row justify-content-center"><div class="col-xl-9"><% attempt.exam.questions.forEach((q,i)=>{ const ans=q.answer; %><div class="card app-card mb-3"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><h2 class="h6">Câu <%= i+1 %>. <%= q.stem %></h2><span class="badge <%= ans.isCorrect?'text-bg-success':'text-bg-danger' %>"><%= ans.isCorrect?'Đúng':'Sai' %> • <%= ans.awardedScore||0 %>/<%= q.points %></span></div><% if(q.questionType==='FILL_BLANK'){ %><div class="mt-2">Bạn trả lời: <strong><%= ans.answerText||'—' %></strong></div><div class="text-success">Đáp án: <strong><%= q.correctAnswer %></strong></div><% } else { %><div class="mt-2"><% q.options.forEach(o=>{ const selected=String(ans.selectedOptionId||'')===String(o.id); %><div class="py-1 <%= o.isCorrect?'text-success fw-semibold':selected?'text-danger':'' %>"><%= o.optionKey %>. <%= o.optionText %> <%= o.isCorrect?'✓':'' %> <%= selected&&!o.isCorrect?'← Bạn chọn':'' %></div><% }) %></div><% } %><% if(q.explanation){ %><div class="alert alert-light border mt-3 mb-0"><strong>Giải thích:</strong> <%= q.explanation %></div><% } %></div></div><% }) %></div></div><% } else { %><div class="alert alert-info">Giáo viên đã cấu hình không hiển thị đáp án chi tiết cho bài kiểm tra này.</div><% } %>
<div class="text-center mt-4"><a href="/student/exams" class="btn btn-outline-primary">Quay lại danh sách kiểm tra</a></div>
<%- include('../../partials/app-end') %>
