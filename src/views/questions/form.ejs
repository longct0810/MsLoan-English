<%- include('../partials/app-start', { title }) %>
<% const f=form||question||{}; const opts=question?.options||[]; const opt=(k)=> (form?form[`option${k}`]:opts.find(o=>o.optionKey===k)?.optionText)||''; const correct=form?.correctOption || opts.find(o=>o.isCorrect)?.optionKey || ''; %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1"><%= title %></h1><p class="text-secondary mb-0">Nhập câu hỏi trực tiếp trên web: chọn loại câu, nhập nội dung và đáp án phù hợp.</p></div><a href="/questions" class="btn btn-outline-secondary">Quay lại</a></div>
<% if(success){ %><div class="alert alert-success"><%= success %></div><% } %>
<% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="post" action="<%= question ? `/questions/${question.id}/update` : '/questions' %>" class="card app-card"><div class="card-body p-4">
<div class="row g-3">
  <div class="col-md-3"><label class="form-label">Khối</label><select class="form-select" name="gradeId"><option value="">Dùng chung</option><% grades.forEach(g=>{ %><option value="<%= g.id %>" <%= String(f.gradeId||'')===String(g.id)?'selected':'' %>><%= g.name %></option><% }) %></select></div>
  <div class="col-md-5"><label class="form-label">Bài học liên quan</label><select class="form-select" name="lessonId"><option value="">Không gắn bài học</option><% lessons.forEach(l=>{ %><option value="<%= l.id %>" <%= String(f.lessonId||'')===String(l.id)?'selected':'' %>><%= l.unitName?`${l.unitName} • `:'' %><%= l.title %></option><% }) %></select></div>
  <div class="col-md-2"><label class="form-label">Loại</label><select class="form-select" name="questionType" id="questionType"><option value="MULTIPLE_CHOICE" <%= (f.questionType||'MULTIPLE_CHOICE')==='MULTIPLE_CHOICE'?'selected':'' %>>Trắc nghiệm</option><option value="TRUE_FALSE" <%= f.questionType==='TRUE_FALSE'?'selected':'' %>>Đúng / Sai</option><option value="FILL_BLANK" <%= f.questionType==='FILL_BLANK'?'selected':'' %>>Điền từ</option><option value="ESSAY" <%= f.questionType==='ESSAY'?'selected':'' %>>Tự luận</option></select></div>
  <div class="col-md-2"><label class="form-label">Độ khó</label><select class="form-select" name="difficulty"><option value="EASY" <%= f.difficulty==='EASY'?'selected':'' %>>Dễ</option><option value="MEDIUM" <%= (f.difficulty||'MEDIUM')==='MEDIUM'?'selected':'' %>>Vừa</option><option value="HARD" <%= f.difficulty==='HARD'?'selected':'' %>>Khó</option></select></div>
  <div class="col-12"><label class="form-label">Nội dung câu hỏi *</label><textarea class="form-control" name="stem" rows="3" required><%= f.stem||'' %></textarea></div>
  <div class="col-md-3"><label class="form-label">Điểm mặc định</label><input class="form-control" type="number" step="0.25" min="0.25" name="defaultPoints" value="<%= f.defaultPoints||questionConfig.defaultPoints %>"></div>
</div>
<hr class="my-4">
<div id="mcqBlock"><h2 class="h6 mb-3">Các lựa chọn</h2><div class="row g-3">
<% ['A','B','C','D'].forEach(k=>{ %><div class="col-md-6"><div class="input-group"><span class="input-group-text"><%= k %></span><input class="form-control" name="option<%= k %>" value="<%= opt(k) %>" placeholder="Nội dung đáp án <%= k %>"></div></div><% }) %>
<div class="col-md-4"><label class="form-label">Đáp án đúng</label><select class="form-select" name="correctOption" id="correctOption"><option value="">-- Chọn --</option><% ['A','B','C','D'].forEach(k=>{ %><option value="<%= k %>" <%= correct===k?'selected':'' %>><%= k %></option><% }) %></select></div></div></div>
<div id="tfBlock" class="d-none"><h2 class="h6">Đáp án đúng</h2><div class="d-flex gap-3"><label class="form-check"><input class="form-check-input" type="radio" name="tfCorrect" value="A" <%= correct==='A'?'checked':'' %>> True</label><label class="form-check"><input class="form-check-input" type="radio" name="tfCorrect" value="B" <%= correct==='B'?'checked':'' %>> False</label></div></div>
<div id="fillBlock" class="d-none"><label class="form-label">Đáp án đúng *</label><input class="form-control" name="correctAnswer" value="<%= f.correctAnswer||'' %>" placeholder="Ví dụ: went"></div>
<div id="essayBlock" class="d-none"><label class="form-label">Đáp án / gợi ý tham khảo</label><textarea class="form-control" name="essayModelAnswer" rows="4" placeholder="Không bắt buộc. Dùng làm gợi ý cho giáo viên khi chấm."><%= f.questionType==='ESSAY'?(f.correctAnswer||''):'' %></textarea><div class="form-text">Câu tự luận không được hệ thống tự chấm.</div></div>
<div class="mt-4"><label class="form-label">Giải thích / hướng dẫn chấm</label><textarea class="form-control" name="explanation" rows="3"><%= f.explanation||'' %></textarea></div>
<div class="d-flex flex-wrap gap-2 mt-4">
<% if(question){ %>
  <button class="btn btn-primary">Lưu thay đổi</button>
<% } else { %>
  <button class="btn btn-primary" name="submitAction" value="addAnother">Lưu & thêm câu tiếp theo</button>
  <button class="btn btn-outline-primary" name="submitAction" value="backToList">Lưu & về ngân hàng</button>
<% } %>
<a href="/questions" class="btn btn-outline-secondary">Hủy</a>
</div>
</div></form>
<script>
(function(){
  const type=document.getElementById('questionType'),mcq=document.getElementById('mcqBlock'),tf=document.getElementById('tfBlock'),fill=document.getElementById('fillBlock'),essay=document.getElementById('essayBlock'),correct=document.getElementById('correctOption');
  const normalCorrect=document.querySelector('input[name="correctAnswer"]'), essayAnswer=document.querySelector('textarea[name="essayModelAnswer"]');
  function sync(){const v=type.value;mcq.classList.toggle('d-none',v!=='MULTIPLE_CHOICE');tf.classList.toggle('d-none',v!=='TRUE_FALSE');fill.classList.toggle('d-none',v!=='FILL_BLANK');essay.classList.toggle('d-none',v!=='ESSAY');if(v==='TRUE_FALSE'){const checked=document.querySelector('input[name=tfCorrect]:checked');correct.value=checked?checked.value:'';}if(v==='ESSAY'&&normalCorrect)normalCorrect.value=essayAnswer.value;}
  document.querySelectorAll('input[name=tfCorrect]').forEach(r=>r.addEventListener('change',()=>{correct.value=r.value;}));
  if(essayAnswer&&normalCorrect)essayAnswer.addEventListener('input',()=>{normalCorrect.value=essayAnswer.value;});
  type.addEventListener('change',sync);sync();
})();
</script>
<%- include('../partials/app-end') %>
