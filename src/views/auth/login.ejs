<%- include('../partials/head', { title }) %>
<div class="login-page d-flex align-items-center justify-content-center p-3">
  <div class="login-card card border-0 shadow-sm overflow-hidden">
    <div class="row g-0">
      <div class="col-lg-6 login-intro p-4 p-lg-5 text-white">
        <div class="brand-mark bg-white text-primary mb-4"><%= appShortName %></div>
        <h1 class="h2 fw-bold"><%= appName %></h1>
        <p class="opacity-75 mb-4">Không gian học tập và theo dõi tiến bộ dành cho giáo viên, học sinh và phụ huynh.</p>
        <div class="small opacity-75">Responsive web • Multi-role portal • v<%= appVersion %></div>
      </div>
      <div class="col-lg-6 bg-white p-4 p-lg-5">
        <h2 class="h4 mb-1">Đăng nhập</h2>
        <p class="text-secondary mb-4">Sử dụng tài khoản phù hợp với vai trò của bạn.</p>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form method="post" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label">Tên tài khoản</label>
            <input class="form-control form-control-lg" name="username" type="text" required autocomplete="username" value="<%= showDemoAccounts ? demoAccounts.teacher.username : '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Mật khẩu</label>
            <input class="form-control form-control-lg" name="password" type="password" required value="<%= showDemoAccounts ? demoAccounts.teacher.password : '' %>">
          </div>
          <button class="btn btn-primary btn-lg w-100">Đăng nhập</button>
        </form>
        <div class="text-center small text-secondary mt-3">Version <strong>v<%= appVersion %></strong></div>
        <% if (showDemoAccounts) { %>
          <div class="demo-hint mt-4 p-3 rounded-3">
            <div class="fw-semibold mb-2">Tài khoản demo</div>
            <div class="small text-secondary"><strong>Giáo viên:</strong> <%= demoAccounts.teacher.username %> / <%= demoAccounts.teacher.password %></div>
            <div class="small text-secondary"><strong>Học sinh:</strong> <%= demoAccounts.student.username %> / <%= demoAccounts.student.password %></div>
            <div class="small text-secondary"><strong>Phụ huynh:</strong> <%= demoAccounts.parent.username %> / <%= demoAccounts.parent.password %></div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<script src="<%= bootstrapJsUrl %>"></script>
<script src="/js/app.js"></script>
</body>
</html>
