<%- include('../partials/head', { title }) %>
<div class="login-page d-flex align-items-center justify-content-center p-3">
  <div class="login-card card border-0 shadow-sm overflow-hidden">
    <div class="row g-0">
      <div class="col-lg-6 login-intro p-4 p-lg-5 text-white">
        <div class="brand-mark bg-white text-primary mb-4">EC</div>
        <h1 class="h2 fw-bold">English Classroom</h1>
        <p class="opacity-75 mb-4">Không gian học tập và theo dõi tiến bộ dành cho giáo viên, học sinh và phụ huynh.</p>
        <div class="small opacity-75">Responsive web • Multi-role portal</div>
      </div>
      <div class="col-lg-6 bg-white p-4 p-lg-5">
        <h2 class="h4 mb-1">Đăng nhập</h2>
        <p class="text-secondary mb-4">Sử dụng tài khoản phù hợp với vai trò của bạn.</p>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form method="post" action="/login">
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control form-control-lg" name="email" type="email" required value="teacher@demo.local">
          </div>
          <div class="mb-3">
            <label class="form-label">Mật khẩu</label>
            <input class="form-control form-control-lg" name="password" type="password" required value="Teacher@123">
          </div>
          <button class="btn btn-primary btn-lg w-100">Đăng nhập</button>
        </form>
        <div class="demo-hint mt-4 p-3 rounded-3">
          <div class="fw-semibold mb-2">Tài khoản demo</div>
          <div class="small text-secondary"><strong>Giáo viên:</strong> teacher@demo.local / Teacher@123</div>
          <div class="small text-secondary"><strong>Học sinh:</strong> student@demo.local / Student@123</div>
          <div class="small text-secondary"><strong>Phụ huynh:</strong> parent@demo.local / Parent@123</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
