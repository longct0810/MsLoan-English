<%- include('../partials/app-start', { title }) %>

<div class="row justify-content-center">
  <div class="col-xl-7 col-lg-8">
    <div class="card app-card border-0">
      <div class="card-body p-4 p-lg-5">
        <div class="d-flex align-items-start gap-3 mb-4">
          <div class="account-security-icon">•••</div>
          <div>
            <div class="eyebrow">Bảo mật tài khoản</div>
            <h1 class="h4 mb-1">Đổi mật khẩu</h1>
            <p class="text-secondary mb-0">Cập nhật mật khẩu đăng nhập cho tài khoản <strong><%= currentUser.username %></strong>.</p>
          </div>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="alert alert-success" role="status"><%= success %></div>
        <% } %>

        <form method="post" action="/account/password" class="password-form" autocomplete="off">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label class="form-label" for="currentPassword">Mật khẩu hiện tại</label>
            <input
              class="form-control form-control-lg"
              id="currentPassword"
              name="currentPassword"
              type="password"
              required
              autocomplete="current-password"
            >
          </div>

          <div class="mb-3">
            <label class="form-label" for="newPassword">Mật khẩu mới</label>
            <input
              class="form-control form-control-lg"
              id="newPassword"
              name="newPassword"
              type="password"
              required
              minlength="<%= minPasswordLength %>"
              maxlength="<%= maxPasswordLength %>"
              autocomplete="new-password"
            >
            <div class="form-text">Từ <%= minPasswordLength %> đến <%= maxPasswordLength %> ký tự và phải khác mật khẩu hiện tại.</div>
          </div>

          <div class="mb-4">
            <label class="form-label" for="confirmPassword">Nhập lại mật khẩu mới</label>
            <input
              class="form-control form-control-lg"
              id="confirmPassword"
              name="confirmPassword"
              type="password"
              required
              minlength="<%= minPasswordLength %>"
              maxlength="<%= maxPasswordLength %>"
              autocomplete="new-password"
            >
          </div>

          <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
            <a class="btn btn-outline-secondary" href="/home">Hủy</a>
            <button class="btn btn-primary" type="submit">Đổi mật khẩu</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/app-end') %>
