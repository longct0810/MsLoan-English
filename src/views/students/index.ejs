<%- include('../partials/app-start', { title }) %>
<div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
  <div><h1 class="h3 mb-1">Học viên</h1><p class="text-secondary mb-0">Quản lý hồ sơ, tài khoản học viên và thông tin phụ huynh.</p></div>
  <a class="btn btn-primary align-self-md-start" href="/students/new">+ Thêm học viên</a>
</div>

<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="card app-card mb-4">
  <div class="card-body">
    <form class="row g-2 align-items-end" method="get">
      <div class="col-md-4">
        <label class="form-label small text-secondary">Lọc theo lớp</label>
        <select class="form-select" name="classId">
          <option value="">Tất cả lớp</option>
          <% classes.forEach(c => { %><option value="<%= c.id %>" <%= String(selectedClassId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </div>
      <div class="col-auto"><button class="btn btn-outline-primary">Áp dụng</button></div>
      <div class="col-md ms-md-auto"><label class="form-label small text-secondary">Tìm nhanh</label><input class="form-control" placeholder="Tên, mã học sinh, tài khoản, trường, phụ huynh..." data-table-search="#allStudentTable"></div>
    </form>
  </div>
</div>

<div class="card app-card">
  <div class="table-responsive">
    <table class="table align-middle mb-0" id="allStudentTable">
      <thead><tr><th>Học viên</th><th>Lớp học</th><th>Trường</th><th>Tài khoản</th><th>Phụ huynh</th><th>Điểm / CC</th><th class="text-end">Thao tác</th></tr></thead>
      <tbody>
        <% if (!students.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">Chưa có học viên.</td></tr><% } %>
        <% students.forEach(s => { %>
          <tr>
            <td><div class="d-flex align-items-center gap-2"><span class="student-avatar small"><%= s.fullName.charAt(0) %></span><div><strong><%= s.fullName %></strong><div class="small text-secondary"><%= s.studentCode || 'Chưa có mã HS' %><% if (s.phone) { %> · <%= s.phone %><% } %></div></div></div></td>
            <td><%= (s.classes || []).join(', ') || '—' %></td>
            <td><%= s.school || '—' %><div class="small text-secondary"><%= s.schoolClass || '' %></div></td>
            <td><div class="small fw-semibold"><%= s.studentUsername || '—' %></div></td>
            <td><strong><%= s.parentName || '—' %></strong><div class="small text-secondary"><%= s.parentPhone || '' %></div><div class="small text-secondary"><%= s.parentUsername ? '@' + s.parentUsername : '' %></div></td>
            <td><span class="score-badge <%= s.averageScore >= 8 ? 'good' : s.averageScore < 7 ? 'warn' : '' %>"><%= s.averageScore %></span><div class="small text-secondary mt-1"><%= s.attendanceRate %>% chuyên cần</div></td>
            <td class="text-end">
              <div class="d-flex justify-content-end gap-1 flex-wrap">
                <a class="btn btn-sm btn-primary" href="/students/<%= s.id %>?classId=<%= selectedClassId || ((s.classIds || [])[0] || '') %>">Xem</a>
                <a class="btn btn-sm btn-outline-primary" href="/students/<%= s.id %>/edit">Sửa</a>
                <form method="post" action="/students/<%= s.id %>/delete" onsubmit="return confirm('Xóa học viên này? Tài khoản học viên sẽ bị khóa, dữ liệu học tập vẫn được giữ lại.');">
                  <button class="btn btn-sm btn-outline-danger">Xóa</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/app-end') %>
