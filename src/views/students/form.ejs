<%- include('../partials/app-start', { title }) %>
<%
  const editing = Boolean(student && student.id);
  const value = (name, fallback = '') => (formData && formData[name] !== undefined && formData[name] !== null ? formData[name] : fallback);
  const selectedClassIds = (formData.classIds || []).map(String);
%>
<div class="mb-3"><a href="/students" class="text-decoration-none">← Danh sách học viên</a></div>
<div class="d-flex justify-content-between align-items-start mb-4">
  <div><h1 class="h3 mb-1"><%= editing ? 'Chỉnh sửa học viên' : 'Thêm học viên' %></h1><p class="text-secondary mb-0">Tài khoản học viên và phụ huynh được quản lý cùng hồ sơ.</p></div>
</div>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger"><strong>Chưa thể lưu:</strong><ul class="mb-0 mt-2"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" action="<%= editing ? '/students/' + student.id : '/students' %>">
  <div class="row g-4">
    <div class="col-xl-7">
      <div class="card app-card mb-4"><div class="card-body p-4">
        <h2 class="h5 mb-3">1. Hồ sơ học viên</h2>
        <div class="row g-3">
          <div class="col-md-8"><label class="form-label">Họ và tên <span class="text-danger">*</span></label><input class="form-control" name="fullName" required value="<%= value('fullName') %>"></div>
          <div class="col-md-4"><label class="form-label">Ngày sinh</label><input type="date" class="form-control" name="dateOfBirth" value="<%= value('dateOfBirth') ? String(value('dateOfBirth')).slice(0,10) : '' %>"></div>
          <div class="col-md-6"><label class="form-label">Trường</label><input class="form-control" name="school" value="<%= value('school') %>"></div>
          <div class="col-md-3"><label class="form-label">Lớp tại trường</label><input class="form-control" name="schoolClass" value="<%= value('schoolClass') %>" placeholder="7A1"></div>
          <div class="col-md-3"><label class="form-label">Điện thoại</label><input class="form-control" name="phone" value="<%= value('phone') %>"></div>
        </div>
      </div></div>

      <div class="card app-card mb-4"><div class="card-body p-4">
        <h2 class="h5 mb-1">2. Tài khoản học viên</h2>
        <p class="text-secondary small"><%= editing ? 'Để trống mật khẩu nếu không muốn thay đổi.' : 'Tài khoản này dùng để học viên đăng nhập Student Portal.' %></p>
        <div class="row g-3">
          <div class="col-md-7"><label class="form-label">Tên tài khoản học viên <span class="text-danger">*</span></label><input type="text" class="form-control" name="studentUsername" required minlength="3" maxlength="50" autocomplete="username" value="<%= value('studentUsername') %>"><div class="form-text">3–50 ký tự: a-z, 0-9, dấu chấm, gạch dưới hoặc gạch ngang. Không dùng email.</div></div>
          <div class="col-md-5"><label class="form-label"><%= editing ? 'Mật khẩu mới' : 'Mật khẩu' %> <%= editing ? '' : '*' %></label><input type="password" minlength="8" class="form-control" name="studentPassword" <%= editing ? '' : 'required' %> autocomplete="new-password"><div class="form-text">Tối thiểu 8 ký tự.</div></div>
        </div>
      </div></div>

      <div class="card app-card"><div class="card-body p-4">
        <h2 class="h5 mb-1">3. Phụ huynh & tài khoản Parent Portal</h2>
        <p class="text-secondary small">Nếu tên tài khoản phụ huynh đã tồn tại, hệ thống sẽ dùng lại đúng một tài khoản đó và gắn thêm học viên này.</p>
        <% if (editing && Number(student.parentStudentCount || 0) > 1) { %>
          <div class="alert alert-info py-2 small">
            <strong>Tài khoản phụ huynh dùng chung:</strong> hiện đang liên kết <%= student.parentStudentCount %> học viên.
            Đổi họ tên/điện thoại/mật khẩu sẽ áp dụng cho cùng tài khoản Parent Portal. Nếu đổi sang một tên tài khoản mới, hệ thống sẽ tách riêng học viên này thay vì đổi tài khoản của anh/chị/em còn lại.
          </div>
        <% } %>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Họ tên phụ huynh <span class="text-danger">*</span></label><input class="form-control" name="parentName" required value="<%= value('parentName') %>"></div>
          <div class="col-md-3"><label class="form-label">Quan hệ</label><select class="form-select" name="relationship"><% ['Bố/Mẹ','Bố','Mẹ','Người giám hộ'].forEach(r => { %><option <%= value('relationship','Bố/Mẹ')===r ? 'selected' : '' %>><%= r %></option><% }) %></select></div>
          <div class="col-md-3"><label class="form-label">Điện thoại</label><input class="form-control" name="parentPhone" value="<%= value('parentPhone') %>"></div>
          <div class="col-md-7"><label class="form-label">Tên tài khoản phụ huynh <span class="text-danger">*</span></label><input type="text" class="form-control" name="parentUsername" required minlength="3" maxlength="50" autocomplete="username" value="<%= value('parentUsername') %>"><div class="form-text">Có thể dùng tên ngắn hoặc số điện thoại; không yêu cầu định dạng email.</div></div>
          <div class="col-md-5"><label class="form-label">Mật khẩu phụ huynh</label><input type="password" minlength="8" class="form-control" name="parentPassword" autocomplete="new-password"><div class="form-text"><%= editing ? (Number(student.parentStudentCount || 0) > 1 ? 'Để trống để giữ nguyên. Nếu nhập mới, mật khẩu của tài khoản phụ huynh dùng chung sẽ đổi cho tất cả học viên liên kết.' : 'Để trống để giữ nguyên.') : 'Bắt buộc nếu tên tài khoản phụ huynh chưa tồn tại; có thể để trống nếu tài khoản đã có.' %></div></div>
        </div>
      </div></div>
    </div>

    <div class="col-xl-5">
      <div class="card app-card sticky-xl-top" style="top:90px"><div class="card-body p-4">
        <h2 class="h5 mb-3">4. Gán vào lớp</h2>
        <p class="small text-secondary">Một học viên có thể thuộc nhiều lớp.</p>
        <div class="vstack gap-2">
          <% classes.forEach(c => { %>
            <label class="border rounded p-3 d-flex gap-3 align-items-start">
              <input class="form-check-input mt-1" type="checkbox" name="classIds" value="<%= c.id %>" <%= selectedClassIds.includes(String(c.id)) ? 'checked' : '' %>>
              <span><strong><%= c.name %></strong><span class="d-block small text-secondary">Khối <%= c.grade %> • <%= c.schedule || '' %></span></span>
            </label>
          <% }) %>
        </div>
        <hr>
        <div class="alert alert-light border small mb-3"><strong>Lưu ý:</strong> khi thêm mới, hệ thống tạo đồng thời tài khoản STUDENT và PARENT. Nếu phụ huynh đã có tài khoản theo tên tài khoản, tài khoản đó được dùng lại. Mã học sinh được tạo tự động theo lớp, ví dụ Y6_HS9.</div>
        <div class="d-grid gap-2"><button class="btn btn-primary"><%= editing ? 'Lưu thay đổi' : 'Tạo học viên & tài khoản' %></button><a class="btn btn-outline-secondary" href="/students">Hủy</a></div>
      </div></div>
    </div>
  </div>
</form>
<%- include('../partials/app-end') %>
