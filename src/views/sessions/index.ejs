<%- include('../partials/app-start', { title }) %>
<%
  const sessionStatus = {
    PLANNED: { label: 'Đã lên lịch', cls: 'text-bg-primary-subtle text-primary-emphasis' },
    IN_PROGRESS: { label: 'Đang thực hiện', cls: 'text-bg-warning-subtle text-warning-emphasis' },
    COMPLETED: { label: 'Đã hoàn thành', cls: 'text-bg-success-subtle text-success-emphasis' },
    CANCELLED: { label: 'Đã hủy', cls: 'text-bg-secondary-subtle text-secondary-emphasis' },
  };
%>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">Buổi học & điểm danh</h1>
    <p class="text-secondary mb-0">Tạo buổi học, theo dõi chuyên cần và ghi nhận nhận xét sau từng buổi.</p>
  </div>
  <a class="btn btn-primary align-self-lg-start" href="/sessions/new<%= selectedClassId ? `?classId=${selectedClassId}` : '' %>">+ Tạo buổi học</a>
</div>

<div class="card app-card mb-4">
  <div class="card-body p-3 p-lg-4">
    <form method="get" action="/sessions" class="row g-3 align-items-end">
      <div class="col-md-6 col-xl-4">
        <label class="form-label small fw-semibold">Lọc theo lớp</label>
        <select class="form-select" name="classId">
          <option value="">Tất cả lớp</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= String(c.id) === String(selectedClassId) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto"><button class="btn btn-outline-primary">Áp dụng</button></div>
      <% if (selectedClassId) { %><div class="col-auto"><a href="/sessions" class="btn btn-light">Xóa lọc</a></div><% } %>
    </form>
  </div>
</div>

<% if (!sessions.length) { %>
  <div class="empty-state app-card bg-white text-center p-5">
    <div class="empty-state-icon mb-3">📅</div>
    <h2 class="h5">Chưa có buổi học</h2>
    <p class="text-secondary">Tạo buổi học đầu tiên để bắt đầu điểm danh và nhận xét học viên.</p>
    <a href="/sessions/new<%= selectedClassId ? `?classId=${selectedClassId}` : '' %>" class="btn btn-primary">Tạo buổi học</a>
  </div>
<% } else { %>
  <div class="card app-card">
    <div class="card-header d-flex flex-column flex-md-row justify-content-between gap-2 align-items-md-center">
      <div><strong>Danh sách buổi học</strong><div class="small text-secondary"><%= sessions.length %> buổi</div></div>
      <input class="form-control form-control-sm table-search" placeholder="Tìm theo lớp/chủ đề..." data-table-search="#sessionTable">
    </div>
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="sessionTable">
        <thead><tr><th>Ngày</th><th>Lớp</th><th>Nội dung</th><th>Điểm danh</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
          <% sessions.forEach(s => { const status = sessionStatus[s.status] || sessionStatus.PLANNED; %>
            <tr>
              <td class="text-nowrap"><strong><%= new Date(s.sessionDate).toLocaleDateString('vi-VN') %></strong><div class="small text-secondary"><%= s.startTime ? String(s.startTime).slice(0,5) : '--:--' %><%= s.endTime ? ` – ${String(s.endTime).slice(0,5)}` : '' %></div></td>
              <td><span class="grade-pill me-2">G<%= s.grade %></span><span class="fw-semibold"><%= s.className %></span></td>
              <td><div class="fw-semibold"><%= s.topic || 'Buổi học' %></div><div class="small text-secondary text-truncate session-topic-preview"><%= s.lessonSummary || 'Chưa có ghi chú nội dung' %></div></td>
              <td>
                <div class="fw-semibold"><%= s.markedCount %>/<%= s.studentCount %></div>
                <div class="small text-secondary"><span class="text-success"><%= s.presentCount + s.onlineCount %> có mặt</span> • <span class="text-warning"><%= s.lateCount %> muộn</span> • <span class="text-danger"><%= s.absentCount %> vắng</span></div>
              </td>
              <td><span class="badge <%= status.cls %>"><%= status.label %></span></td>
              <td class="text-end"><a href="/sessions/<%= s.id %>" class="btn btn-sm btn-outline-primary">Mở buổi học</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
<%- include('../partials/app-end') %>
