# Copy file này thành .env trước khi chạy ứng dụng.
# Không commit .env thật lên Git.

# =========================================================
# APPLICATION
# =========================================================
APP_NAME=English Classroom
APP_SHORT_NAME=EC
# Để trống để tự lấy version từ package.json
APP_VERSION=
APP_HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh
API_PREFIX=/api/v1
TRUST_PROXY=0
BODY_JSON_LIMIT=1mb
BODY_URLENCODED_LIMIT=1mb

# =========================================================
# FRONTEND ASSETS
# =========================================================
BOOTSTRAP_CSS_URL=https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css
BOOTSTRAP_JS_URL=https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js

# =========================================================
# SESSION / COOKIE
# =========================================================
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=english_classroom_sid
SESSION_MAX_AGE_MS=28800000
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE=false
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false
SESSION_TABLE_NAME=user_sessions
SESSION_CREATE_TABLE_IF_MISSING=true

# =========================================================
# DEMO / SEED
# =========================================================
DEMO_MODE=true
SHOW_DEMO_ACCOUNTS_ON_LOGIN=true
BCRYPT_ROUNDS=10
DEFAULT_SCHOOL_YEAR=2026-2027

DEMO_TEACHER_NAME=Giáo viên Demo
DEMO_TEACHER_EMAIL=teacher@demo.local
DEMO_TEACHER_PASSWORD=Teacher@123

DEMO_STUDENT_NAME=Lê Hoàng Nam
DEMO_STUDENT_EMAIL=student@demo.local
DEMO_STUDENT_PASSWORD=Student@123

DEMO_PARENT_NAME=Phụ huynh Demo
DEMO_PARENT_EMAIL=parent@demo.local
DEMO_PARENT_PASSWORD=Parent@123

# =========================================================
# POSTGRESQL
# =========================================================
# Production/Neon: ưu tiên DATABASE_URL. Không commit giá trị thật lên Git.
DATABASE_URL=
DB_CHANNEL_BINDING=false
DB_STARTUP_CHECK=true

# Local fallback (dùng khi DATABASE_URL để trống)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=english_classroom
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# =========================================================
# DOCKER POSTGRESQL
# =========================================================
POSTGRES_IMAGE=postgres:16
POSTGRES_CONTAINER_PORT=5432
DOCKER_DB_CONTAINER_NAME=english-classroom-postgres
DB_VOLUME_NAME=english_classroom_pgdata

# =========================================================
# ONLINE EXAM / QUESTION BANK
# =========================================================
EXAM_DEFAULT_DURATION_MINUTES=30
EXAM_MAX_DURATION_MINUTES=360
EXAM_DEFAULT_MAX_ATTEMPTS=1
EXAM_MAX_ATTEMPTS=10
EXAM_DEFAULT_SHOW_RESULT=true
EXAM_AUTOSAVE_DEBOUNCE_MS=500
QUESTION_DEFAULT_POINTS=1
QUESTION_MAX_POINTS=100

# Question bank bulk import
QUESTION_IMPORT_MAX_ROWS=2000
QUESTION_IMPORT_MAX_FILE_MB=5

# Assignment 2.0 uploads (stored in PostgreSQL in v0.18)
ASSIGNMENT_UPLOAD_MAX_FILE_MB=10
ASSIGNMENT_UPLOAD_MAX_FILES=3
