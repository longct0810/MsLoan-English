<%- include('../partials/app-start', { title }) %>
<div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
  <div><h1 class="h3 mb-1">Quản lý lớp học</h1><p class="text-secondary mb-0">Các lớp tiếng Anh khối 6, 7, 8, 9.</p></div>
  <button class="btn btn-primary align-self-md-start" disabled>+ Thêm lớp</button>
</div>

<div class="row g-3">
  <% classes.forEach(c => { %>
    <div class="col-md-6 col-xl-4">
      <a href="/classes/<%= c.id %>" class="card class-card h-100 text-decoration-none">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-4">
            <span class="grade-pill large">G<%= c.grade %></span>
            <span class="badge text-bg-success-subtle text-success-emphasis">Đang học</span>
          </div>
          <h2 class="h5 text-body"><%= c.name %></h2>
          <div class="text-secondary small mb-3"><%= c.schedule %></div>
          <div class="d-flex justify-content-between border-top pt-3 text-body">
            <span><strong><%= c.studentCount %></strong> học viên</span>
            <span class="text-secondary"><%= c.schoolYear %></span>
          </div>
        </div>
      </a>
    </div>
  <% }) %>
</div>
<%- include('../partials/app-end') %>
